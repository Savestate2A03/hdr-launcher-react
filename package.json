{
  "name": "hdr-launcher",
  "author": "techyCoder81",
  "version": "0.1.0",
  "description": "The HDR Launcher",
  "repository": "techyCoder81/hdr-launcher-react",
  "license": "MIT",
  "packageManager": "yarn@4.10.3",
  "contributors": [
    {
      "name": "techyCoder81"
    }
  ],
  "main": "./src/main/main.ts",
  "scripts": {
    "build": "concurrently \"yarn build:main\" \"yarn build:renderer\"",
    "build:main": "cross-env NODE_ENV=production tsx ./node_modules/webpack/bin/webpack.js --config ./.erb/configs/webpack.config.main.prod.ts",
    "build:renderer": "cross-env NODE_ENV=production tsx ./node_modules/webpack/bin/webpack.js --config ./.erb/configs/webpack.config.renderer.prod.ts",
    "postinstall": "tsx .erb/scripts/check-native-dep.js && cross-env NODE_ENV=development tsx ./node_modules/webpack/bin/webpack.js --config ./.erb/configs/webpack.config.renderer.dev.dll.ts",
    "lint": "cross-env NODE_ENV=development eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0 --fix",
    "package": "tsx ./.erb/scripts/clean.js dist && yarn build && electron-builder build --publish never",
    "prepare": "husky install",
    "rebuild": "electron-rebuild --parallel --types prod,dev,optional --module-dir release/app",
    "start": "tsx ./.erb/scripts/check-port-in-use.js && yarn start:renderer",
    "start:main": "cross-env NODE_ENV=development electronmon ./.erb/scripts/run-main.js",
    "start:preload": "cross-env NODE_ENV=development tsx ./node_modules/webpack/bin/webpack.js --config ./.erb/configs/webpack.config.preload.dev.ts",
    "start:renderer": "cross-env NODE_ENV=development tsx ./node_modules/webpack/bin/webpack.js serve --config ./.erb/configs/webpack.config.renderer.dev.ts",
    "test": "jest"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "cross-env NODE_ENV=development eslint --cache"
    ],
    "*.json,.{eslintrc,prettierrc}": [
      "prettier --ignore-path .eslintignore --parser json --write"
    ],
    "*.{css,scss}": [
      "prettier --ignore-path .eslintignore --single-quote --write"
    ],
    "*.{html,md,yml}": [
      "prettier --ignore-path .eslintignore --single-quote --write"
    ]
  },
  "browserslist": [],
  "prettier": {
    "singleQuote": true,
    "overrides": [
      {
        "files": [
          ".prettierrc",
          ".eslintrc"
        ],
        "options": {
          "parser": "json"
        }
      }
    ]
  },
  "jest": {
    "moduleDirectories": [
      "node_modules",
      "release/app/node_modules",
      "src"
    ],
    "moduleFileExtensions": [
      "js",
      "jsx",
      "ts",
      "tsx",
      "json"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/.erb/mocks/fileMock.js",
      "\\.(css|less|sass|scss)$": "identity-obj-proxy"
    },
    "setupFiles": [
      "./.erb/scripts/check-build-exists.ts"
    ],
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "http://localhost/"
    },
    "testPathIgnorePatterns": [
      "release/app/dist"
    ],
    "transform": {
      "\\.(ts|tsx|js|jsx)$": "ts-jest"
    }
  },
  "dependencies": {
    "@ramonak/react-progress-bar": "5.4.0",
    "axios": "1.13.2",
    "electron-debug": "4.1.0",
    "electron-log": "5.4.3",
    "electron-updater": "6.6.2",
    "glob": "13.0.0",
    "md5-file": "5.0.0",
    "nx-request-api": "0.1.21",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-modal": "3.16.3",
    "react-remark": "2.1.0",
    "react-router-dom": "7.10.1",
    "react-twitter-embed": "4.0.4",
    "xdg-portable": "10.6.0"
  },
  "devDependencies": {
    "@pmmmwh/react-refresh-webpack-plugin": "0.6.2",
    "@svgr/webpack": "8.1.0",
    "@teamsupercell/typings-for-css-modules-loader": "2.5.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/jest": "29.5.12",
    "@types/node": "22.9.4",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@types/react-modal": "3.16.3",
    "@types/react-test-renderer": "19.1.0",
    "@types/terser-webpack-plugin": "5.2.0",
    "@types/webpack-bundle-analyzer": "4.7.0",
    "@types/webpack-env": "1.18.8",
    "@typescript-eslint/eslint-plugin": "8.49.0",
    "@typescript-eslint/parser": "8.49.0",
    "browserslist-config-erb": "0.0.3",
    "chalk": "5.6.2",
    "concurrently": "9.2.1",
    "core-js": "3.47.0",
    "cross-env": "10.1.0",
    "css-loader": "7.1.2",
    "css-minimizer-webpack-plugin": "7.0.4",
    "detect-port": "2.1.0",
    "electron": "39.2.7",
    "electron-builder": "26.0.12",
    "electron-devtools-installer": "4.0.0",
    "electron-notarize": "1.2.2",
    "electron-rebuild": "3.2.9",
    "electronmon": "2.0.4",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-erb": "4.1.0",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-import-resolver-webpack": "0.13.10",
    "eslint-plugin-compat": "6.0.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.4.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-promise": "7.2.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "file-loader": "6.2.0",
    "html-webpack-plugin": "5.6.5",
    "husky": "9.1.7",
    "identity-obj-proxy": "3.0.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "lint-staged": "16.2.7",
    "mini-css-extract-plugin": "2.9.4",
    "prettier": "3.7.4",
    "react-refresh": "0.18.0",
    "react-test-renderer": "18.3.1",
    "rimraf": "6.1.2",
    "sass": "1.96.0",
    "sass-loader": "16.0.6",
    "style-loader": "4.0.0",
    "terser-webpack-plugin": "5.3.16",
    "ts-jest": "29.4.6",
    "ts-loader": "9.5.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "url-loader": "4.1.1",
    "webpack": "5.103.0",
    "webpack-assets-manifest": "6.5.0",
    "webpack-bundle-analyzer": "5.1.0",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "5.2.2",
    "webpack-merge": "6.0.1"
  },
  "build": {
    "productName": "HDRLauncher",
    "appId": "org.hdr.Launcher",
    "asar": true,
    "asarUnpack": "**\\*.{node,dll}",
    "files": [
      "dist",
      "node_modules",
      "package.json"
    ],
    "afterSign": ".erb/scripts/notarize.js",
    "mac": {
      "target": {
        "target": "default",
        "arch": [
          "arm64",
          "x64"
        ]
      },
      "type": "distribution",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "directories": {
      "app": "release/app",
      "buildResources": "assets",
      "output": "release/build"
    },
    "extraResources": [
      "./assets/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "techyCoder81",
      "repo": "hdr-launcher-react"
    }
  },
  "engines": {
    "node": ">=18.x"
  },
  "electronmon": {
    "patterns": [
      "!**/**",
      "src/main/**"
    ],
    "logLevel": "quiet"
  }
}
